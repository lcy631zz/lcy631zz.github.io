# ============================================
# System files
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Editor / IDE files
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.ropeproject/

# ============================================
# Hugo build output
# ============================================
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Old static HTML files (replaced by Hugo source)
/index.html
/index.xml
/index.json
/sitemap.xml
/404.html
/robots.txt
/site.webmanifest
/favicon*.png
/favicon.ico
/android-chrome-*.png
/apple-touch-icon.png
/css/
/js/
/about/
/blog/
/projects/
/tags/
/categories/
/page/

# ============================================
# Hugo Modules cache
# ============================================
/modules/

# ============================================
# Node / npm (if using PostCSS, etc.)
# ============================================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# Secrets & credentials — NEVER commit these
# ============================================
.env
.env.*
.env.local
*.pem
*.key
*.p12
*.pfx
*credentials*
*token*
*secret*

# ============================================
# OS metadata
# ============================================
.Spotlight-V100
.Trashes
ehthumbs.db

# ============================================
# Misc
# ============================================
*.log
*.tmp
.cache/
.githooks/
__pycache__/
*.pyc
